{
  "info": {
    "name": "Samtli Assignment Verification",
    "description": "End-to-end Postman collection for the Samtli PHP assignment flows: registration, login, group creation, membership request, administrator approval, discussion creation, replies and invitation links.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:38515"
    },
    {
      "key": "password",
      "value": "correct horse battery staple"
    }
  ],
  "item": [
    {
      "name": "01 Open Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('register page loads', function () { pm.response.to.have.status(200); });",
              "const token = pm.response.text().match(/name=\"_csrf\" value=\"([^\"]+)\"/);",
              "pm.test('register CSRF token exists', function () { pm.expect(token).to.not.equal(null); });",
              "pm.collectionVariables.set('csrf_register', token[1]);",
              "pm.collectionVariables.set('run_id', Date.now().toString());",
              "pm.collectionVariables.set('admin_email', `postman-admin-${pm.collectionVariables.get('run_id')}@example.test`);",
              "pm.collectionVariables.set('applicant_email', `postman-applicant-${pm.collectionVariables.get('run_id')}@example.test`);",
              "pm.collectionVariables.set('invitee_email', `postman-invitee-${pm.collectionVariables.get('run_id')}@example.test`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/register"
      }
    },
    {
      "name": "02 Register Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "_csrf",
              "value": "{{csrf_register}}"
            },
            {
              "key": "first_name",
              "value": "Postman"
            },
            {
              "key": "last_name",
              "value": "Admin"
            },
            {
              "key": "email",
              "value": "{{admin_email}}"
            },
            {
              "key": "password",
              "value": "{{password}}"
            },
            {
              "key": "password_confirmation",
              "value": "{{password}}"
            }
          ]
        },
        "url": "{{base_url}}/register"
      }
    },
