              "pm.test('invitation accept returns to group page', function () { pm.expect(pm.response.headers.get('Location')).to.equal(`/groups/${pm.collectionVariables.get('group_id')}`); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "_csrf",
              "value": "{{csrf_invitation_accept}}"
            }
          ]
        },
        "url": "{{invite_url}}/accept"
      }
    },
    {
      "name": "25 Reopen Used Invitation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('used invitation is gone', function () { pm.response.to.have.status(410); });",
              "pm.test('used invitation page is unavailable', function () { pm.expect(pm.response.text()).to.include('Invitation unavailable'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{invite_url}}"
      }
    }
  ]
}
