{
    "name": "hampus-fsu25d/samtli",
    "description": "Server-rendered PHP community platform for interest-based groups and discussions.",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Samtli\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "scripts": {
        "check:syntax": "find public src templates tests bin -name '*.php' -print0 | xargs -0 -n1 php -l",
        "migrate": "php bin/migrate.php",
        "verify:schema": "php tests/Integration/verify_schema.php",
        "verify:registration": "php tests/Integration/verify_registration.php",
        "test": [
            "@verify:schema",
            "@verify:registration"
        ]
    }
}
